# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging and build outputs
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test and coverage outputs
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# Type checking and lint caches
.mypy_cache/
.pyright/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Local environment files
.env
.env.*
!.env.example

# Generated data and experiment artifacts
artifacts/**
!artifacts/.gitkeep
data/raw/**
!data/raw/.gitkeep
data/processed/**
!data/processed/.gitkeep

# Large generated media files
*.mp4
*.mov
*.avi
*.gif

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# Logs
*.log
logs/
